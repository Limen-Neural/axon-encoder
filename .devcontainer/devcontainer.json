{
  "name": "axon-encoder Rust 1.97.1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "cargo fetch",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
